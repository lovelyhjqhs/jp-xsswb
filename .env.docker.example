# 供 docker compose 读取的环境变量（复制成根目录 .env 后使用）
#   cp .env.docker.example .env
# 注意：根目录的 .env 已被 .gitignore 忽略，不要提交真实密码

# ---------- 必改：安全相关 ----------
# 32 位以上的随机字符串，可用 `openssl rand -base64 48` 生成
JWT_SECRET=""
ADMIN_COOKIE_SECURE="true"
PUBLIC_QUERY_TTL_DAYS=30

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE="campus_lostfound"
MYSQL_USER="campus"
MYSQL_PASSWORD=""

# ---------- 服务 ----------
# 对外暴露的 HTTP 端口（生产上通常由更外层的 nginx/负载均衡再转发 443）
HTTP_PORT=8080

# ---------- 隐私与保留 ----------
AUDIT_LOG_RETENTION_DAYS=365
# 生产站点完整 URL，例如 https://department.school.edu.cn
PUBLIC_SITE_URL=""

# ---------- 限流 ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# ---------- 其他 ----------
# API 文档默认关闭
ENABLE_API_DOCS=false
LOG_LEVEL="info"
# 同域部署不需要改；若前端独立域名，在这里填白名单（逗号分隔）
CORS_ORIGINS=""
# 生产若使用「外层 TLS 代理 -> 项目 nginx -> 后端」，填 2；
# 直接由项目 nginx 接收请求时填 1。
TRUST_PROXY=1
