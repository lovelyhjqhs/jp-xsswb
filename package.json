{
  "name": "campus-lostfound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "校园失物招领网站（monorepo：frontend / backend）",
  "engines": {
    "node": ">=20.6"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "start:backend": "npm --workspace backend run start",
    "db:generate": "npm --workspace backend run db:generate",
    "db:migrate": "npm --workspace backend run db:migrate",
    "db:deploy": "npm --workspace backend run db:deploy",
    "db:seed": "npm --workspace backend run db:seed",
    "db:reset": "npm --workspace backend run db:reset",
    "db:studio": "npm --workspace backend run db:studio",
    "job:archive": "npm --workspace backend run job:archive",
    "job:archive:dry": "npm --workspace backend run job:archive:dry",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:recreate": "docker compose up -d --force-recreate",
    "docker:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-deploy.ps1",
    "docker:logs": "docker compose logs -f backend",
    "backup:db": "docker compose --profile ops run --rm backup",
    "test": "npm --workspace backend run test",
    "test:db:init": "node scripts/init-test-db.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "prisma@6.19.3": true
  }
}
