# 依赖
node_modules/
**/node_modules/

# 构建产物
dist/
build/
coverage/

# 环境变量（模板 .env.example / .env.docker.example 必须提交，真实 .env 绝不提交）
.env
.env.local
.env.*.local

# 用户上传的图片（含测试用的 uploads-test）
backend/uploads*/
backend/private-uploads/
!backend/uploads/.gitkeep

# 数据库备份产物（含未完成的 .part 文件）
backups/
*.part

# Prisma 生成的客户端
**/generated/prisma/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 一次性部署临时文件
.deploy_tmp/
