# ============================================================
# 校园失物招领 —— 环境变量模板
# 用法：复制成 backend/.env 后再改值（backend/.env 已被 .gitignore 忽略）
#   PowerShell:  Copy-Item .env.example backend\.env
#   Bash:        cp .env.example backend/.env
# ============================================================

# ---------- 数据库（Prisma 读取，MySQL） ----------
# 本地开发库由根目录 docker-compose.yml 提供
DATABASE_URL="mysql://campus:campus_dev_pwd@127.0.0.1:3306/campus_lostfound"

# ---------- 服务 ----------
NODE_ENV="development"
PORT=3000

# ---------- 认证 ----------
# 生产环境必须替换为 32 位以上的随机字符串
JWT_SECRET="dev-only-secret-change-me-0123456789abcdef"
JWT_EXPIRES_IN="7d"
ADMIN_SESSION_COOKIE="admin_session"
ADMIN_CSRF_COOKIE="admin_csrf"
ADMIN_SESSION_TTL_MINUTES=480
ADMIN_COOKIE_SECURE="false"
PUBLIC_QUERY_TTL_DAYS=30

# ---------- 文件上传 ----------
# 已发布官网图片存储目录（相对 backend/，也可填绝对路径）
UPLOAD_DIR="uploads"
# 游客投稿附件专用私有目录
PRIVATE_UPLOAD_DIR="private-uploads"
AUDIT_LOG_RETENTION_DAYS=365
PUBLIC_SITE_URL=""

# ---------- 安全 ----------
# 跨域白名单（逗号分隔）。生产用 nginx 同域反代时可以留空，
# 但本地开发前端在 5173，需要放行。
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# 反向代理层数：nginx 前置时填 1，限流才能按真实客户端 IP 计数
TRUST_PROXY=0

# 全局限流：15 分钟内同一 IP 最多 600 次请求
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# API 文档默认关闭；只有明确需要时再开启
ENABLE_API_DOCS=false

# 日志级别：debug / info / warn / error
LOG_LEVEL="info"

