{
  "name": "@campus-lostfound/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "校园失物招领 —— 后端 API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "job:archive": "node --env-file=.env scripts/archive-stale-items.js",
    "job:archive:dry": "node --env-file=.env scripts/archive-stale-items.js --dry-run",
    "job:maintenance": "node --env-file=.env scripts/maintenance.js",
    "pretest": "prisma generate",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
